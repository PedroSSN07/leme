rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function productFields() {
      return [
        'id',
        'name',
        'image',
        'category',
        'badge',
        'price',
        'stock',
        'sizes',
        'description'
      ];
    }

    function validProduct(data) {
      return data.keys().hasOnly(productFields())
        && data.keys().hasAll(productFields())
        && data.id is int
        && data.id > 0
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.image is string
        && data.image.size() > 0
        && data.image.size() <= 900000
        && data.image.matches('^https://.+|^data:image/(png|jpeg|webp);base64,.+')
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.category in [
          't-shirts-basicas',
          'basicas-femininas',
          'basicas-masculinas',
          'colecao-leme',
          'religiosas',
          'personalizadas',
          'camisas-masculinas',
          'oversized'
        ]
        && data.badge is string
        && data.badge.size() > 0
        && data.badge.size() <= 40
        && (data.price is int || data.price is float)
        && data.price >= 0
        && data.price <= 1000000
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 100000
        && data.sizes is string
        && data.sizes.size() > 0
        && data.sizes.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000;
    }

    match /produtos/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
